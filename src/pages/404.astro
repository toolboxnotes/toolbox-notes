---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';

const s = t('en');
const k = t('ko');
---

<Base lang="en" title="404">
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1>{s.notFound}</h1>
    <p>{s.notFoundBody} / {k.notFoundBody}</p>
    <p style="margin-top:20px"><a href="/en/">English</a> · <a href="/ko/">한국어</a></p>
  </section>
</Base>
