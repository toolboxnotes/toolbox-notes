---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { SITE_LANG } from "../config";

const aboutPost = await getEntry("spec", "contact");

if (!aboutPost) {
	throw new Error("Contact page content not found");
}

const { Content } = await render(aboutPost);
const privacyTitle = SITE_LANG === "ko" ? "문의" : "Contact";
const pageDescription = SITE_LANG === "ko" ? "Toolbox Notes와 SellerMorning에 대한 질문, 제안, 사용 문의는 toolbox@toolboxnotes.com으로 보내 주세요." : "Questions, suggestions or SellerMorning inquiries for Toolbox Notes: email toolbox@toolboxnotes.com.";
---
<MainGridLayout title={privacyTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>