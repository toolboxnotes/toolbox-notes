---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { SITE_LANG } from "../config";

const aboutPost = await getEntry("spec", "privacy");

if (!aboutPost) {
	throw new Error("Privacy page content not found");
}

const { Content } = await render(aboutPost);
const privacyTitle = SITE_LANG === "ko" ? "개인정보처리방침" : "Privacy Policy";
const pageDescription = SITE_LANG === "ko" ? "Toolbox Notes 개인정보처리방침: 브라우저 저장소, Google AdSense 광고 쿠키, 호스팅, 문의 메일 처리 방식을 안내합니다." : "Toolbox Notes privacy policy: browser storage, Google AdSense advertising cookies, hosting and how emails you send are handled.";
---
<MainGridLayout title={privacyTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>