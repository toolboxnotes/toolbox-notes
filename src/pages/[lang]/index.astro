---
import Base from '../../layouts/Base.astro';
import { LANGS, t, formatDate, getPosts, splitId, postUrl, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
const posts = await getPosts(lang);
---

<Base lang={lang} alternates={{ en: '/en/', ko: '/ko/' }}>
  <section class="hero">
    <p class="eyebrow">{s.siteName}</p>
    <h1>{s.tagline}</h1>
    <p>{s.intro}</p>
  </section>

  <h2 class="section-title">{s.latest}</h2>
  {
    posts.length === 0 ? (
      <p>{s.noPosts}</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={postUrl(lang, splitId(post.id).slug)}>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="tags">
                  {post.data.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
