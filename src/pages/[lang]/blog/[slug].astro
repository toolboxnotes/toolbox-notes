---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { LANGS, LANG_LABEL, t, formatDate, getPosts, splitId, postUrl, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const posts = await getPosts();
  // slug -> languages that have this post
  const available = new Map<string, Set<Lang>>();
  for (const p of posts) {
    const { lang, slug } = splitId(p.id);
    if (!available.has(slug)) available.set(slug, new Set());
    available.get(slug)!.add(lang);
  }
  return posts.map((post) => {
    const { lang, slug } = splitId(post.id);
    const alternates: Partial<Record<Lang, string>> = {};
    for (const l of available.get(slug) ?? []) alternates[l] = postUrl(l, slug);
    return { params: { lang, slug }, props: { post, alternates } };
  });
}

const { post, alternates } = Astro.props;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const { Content } = await render(post);
const other = LANGS.find((l) => l !== lang)!;
const otherUrl = alternates[other];
---

<Base lang={lang} title={post.data.title} description={post.data.description} alternates={alternates} type="article">
  <article class="article">
    <header class="article-head">
      <a class="back" href={`/${lang}/`}>{s.backToList}</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span>{s.published} <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time></span>
        {
          post.data.updatedDate && (
            <span>{s.updated} <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, lang)}</time></span>
          )
        }
      </div>
      {
        post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      otherUrl && (
        <p class="lang-note">
          {s.switchTo}: <a href={otherUrl} hreflang={other} data-set-lang={other}>{LANG_LABEL[other]}</a>
        </p>
      )
    }
  </article>
</Base>
