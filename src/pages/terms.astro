---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { SITE_LANG } from "../config";

const aboutPost = await getEntry("spec", "terms");

if (!aboutPost) {
	throw new Error("Terms page content not found");
}

const { Content } = await render(aboutPost);
const termsTitle = SITE_LANG === "ko" ? "이용약관" : "Terms of Use";
const pageDescription = SITE_LANG === "ko" ? "Toolbox Notes 이용약관: 콘텐츠 이용 범위, 정보의 정확성과 책임 한계, 외부 링크와 광고, 약관 변경에 대해 안내합니다." : "Toolbox Notes terms of use: how you may use the content, accuracy and limits of liability, external links and ads, and changes to these terms.";
---
<MainGridLayout title={termsTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>