---
import '../styles/global.css';
import { LANGS, LANG_LABEL, HTML_LANG, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** URL of this same page in each language; missing langs fall back to that lang's home */
  alternates?: Partial<Record<Lang, string>>;
  type?: 'website' | 'article';
}

const { lang, title, description, alternates = {}, type = 'website' } = Astro.props;
const s = t(lang);
const pageTitle = title ? `${title} | ${s.siteName}` : `${s.siteName} — ${s.tagline}`;
const desc = description ?? s.intro;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = (l: Lang) => alternates[l] ?? `/${l}/`;
const hasAlt = (l: Lang) => Boolean(alternates[l]);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {
      LANGS.filter(hasAlt).map((l) => (
        <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(alt(l), Astro.site)} />
      ))
    }
    {hasAlt('en') && <link rel="alternate" hreflang="x-default" href={new URL(alt('en'), Astro.site)} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? s.siteName} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={s.siteName} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={`/${lang}/`}>
          <span class="brand-mark" aria-hidden="true">▤</span>
          <span>{s.siteName}</span>
        </a>
        <nav class="nav">
          <a href={`/${lang}/`}>{s.home}</a>
          <a href={`/${lang}/about/`}>{s.about}</a>
          <span class="lang-switch" aria-label={s.switchTo}>
            {
              LANGS.map((l) =>
                l === lang ? (
                  <span class="lang current" aria-current="true">{LANG_LABEL[l]}</span>
                ) : (
                  <a class="lang" href={alt(l)} hreflang={HTML_LANG[l]} data-set-lang={l}>
                    {LANG_LABEL[l]}
                  </a>
                ),
              )
            }
          </span>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>© {year} {s.siteName}. {s.rights}</span>
        <span class="footer-links">
          <a href={`/${lang}/about/`}>{s.about}</a>
          <a href={`/${lang}/privacy/`}>{s.privacy}</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      // Remember a manual language choice so the home page redirect respects it next time
      document.querySelectorAll('[data-set-lang]').forEach(function (a) {
        a.addEventListener('click', function () {
          try { localStorage.setItem('lang', a.getAttribute('data-set-lang')); } catch (e) {}
        });
      });
    </script>
  </body>
</html>
